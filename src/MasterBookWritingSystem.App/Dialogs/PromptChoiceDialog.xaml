<Window x:Class="MasterBookWritingSystem.App.Dialogs.PromptChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ListBox Grid.Row="1"
                 x:Name="ChoicesList"
                 ItemsSource="{Binding Choices}"
                 DisplayMemberPath="Label"
                 Margin="0,0,0,12"
                 AutomationProperties.Name="Choice list" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

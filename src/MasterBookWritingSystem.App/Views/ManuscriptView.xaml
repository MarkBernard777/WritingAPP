<UserControl x:Class="MasterBookWritingSystem.App.Views.ManuscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterBookWritingSystem.App.ViewModels"
             xmlns:views="clr-namespace:MasterBookWritingSystem.App.Views"
             xmlns:manuscript="clr-namespace:MasterBookWritingSystem.Core.Manuscript;assembly=MasterBookWritingSystem.Core">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:HierarchyNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MinHeight="28">
                <Border Width="18" Height="18" Margin="0,0,6,0" CornerRadius="2"
                        Background="{DynamicResource AppBorderBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <CheckBox Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsSelectedForCompile, Mode=TwoWay}"
                          Visibility="{Binding IsChapter, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.Name="Include chapter in compile" />
                <TextBlock Text="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="220"
                           AutomationProperties.Name="{Binding AccessibleName}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Exit focus"
                        MinWidth="90"
                        Margin="0,0,6,0"
                        Command="{Binding ExitDistractionFreeCommand}"
                        Visibility="{Binding IsDistractionFreeMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="Exit distraction-free mode"
                        ToolTip="Restore navigation panels (Esc)" />
                <Button Content="Focus"
                        MinWidth="70"
                        Margin="0,0,6,0"
                        Command="{Binding ToggleDistractionFreeCommand}"
                        Visibility="{Binding IsDistractionFreeMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                        AutomationProperties.Name="Enter distraction-free mode"
                        ToolTip="Hide navigation panels. Esc exits." />
                <Button Content="{Binding LeftPanelToggleLabel}"
                        MinWidth="110"
                        Margin="0,0,6,0"
                        Command="{Binding ToggleLeftPanelCommand}"
                        Visibility="{Binding IsDistractionFreeMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                        AutomationProperties.Name="{Binding LeftPanelToggleLabel}"
                        ToolTip="Collapse or expand the hierarchy panel without losing selection state." />
                <Button Content="{Binding RightPanelToggleLabel}"
                        MinWidth="110"
                        Margin="0,0,6,0"
                        Command="{Binding ToggleRightPanelCommand}"
                        Visibility="{Binding IsDistractionFreeMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                        AutomationProperties.Name="{Binding RightPanelToggleLabel}"
                        ToolTip="Collapse or expand the context panel without losing selection state." />
                <Button Content="{Binding CorkboardToggleLabel}"
                        MinWidth="120"
                        Margin="0,0,6,0"
                        Command="{Binding ToggleCorkboardCommand}"
                        Visibility="{Binding IsDistractionFreeMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                        AutomationProperties.Name="{Binding CorkboardToggleLabel}"
                        ToolTip="Switch between the chapter editor and the scene corkboard (canonical Story Data scenes)." />
                <Button Content="Undo"
                        MinWidth="64"
                        Margin="0,0,6,0"
                        Command="ApplicationCommands.Undo"
                        CommandTarget="{Binding ElementName=MarkdownEditor}"
                        ToolTip="Undo manuscript text (Ctrl+Z)"
                        AutomationProperties.Name="Undo manuscript text" />
                <Button Content="Redo"
                        MinWidth="64"
                        Margin="0,0,6,0"
                        Command="ApplicationCommands.Redo"
                        CommandTarget="{Binding ElementName=MarkdownEditor}"
                        ToolTip="Redo manuscript text (Ctrl+Y)"
                        AutomationProperties.Name="Redo manuscript text" />
                <Button Content="Refresh"
                        MinWidth="80"
                        Command="{Binding RefreshCommand}"
                        Visibility="{Binding IsDistractionFreeMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                        AutomationProperties.Name="Refresh manuscript hierarchy" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Manuscript"
                           FontSize="26"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <TextBlock Text="{Binding SaveStateDisplay}"
                           Style="{StaticResource SaveStateLiveTextStyle}"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding SaveStateAccessibleName}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusLiveTextStyle}"
                   Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

        <Grid Grid.Row="1" Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="0" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Left: hierarchy -->
            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Style="{StaticResource PanelBorderStyle}"
                    Width="300"
                    Visibility="{Binding IsLeftChromeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8">
                        <TextBlock Text="Hierarchy" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding HierarchyFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 AutomationProperties.Name="Filter hierarchy"
                                 AutomationProperties.HelpText="Filter books, parts, chapters and scenes by title." />
                        <WrapPanel>
                            <Button Content="Book" MinWidth="56" MinHeight="28" Margin="0,0,4,4"
                                    Command="{Binding AddBookCommand}"
                                    AutomationProperties.Name="Add book" />
                            <Button Content="Part" MinWidth="56" MinHeight="28" Margin="0,0,4,4"
                                    Command="{Binding AddPartCommand}"
                                    AutomationProperties.Name="Add part" />
                            <Button Content="Chapter" MinWidth="68" MinHeight="28" Margin="0,0,4,4"
                                    Command="{Binding AddChapterCommand}"
                                    AutomationProperties.Name="Add chapter" />
                            <Button Content="Rename" MinWidth="64" MinHeight="28" Margin="0,0,4,4"
                                    Command="{Binding RenameSelectedCommand}"
                                    AutomationProperties.Name="Rename selected hierarchy item" />
                            <Button Content="Delete" MinWidth="64" MinHeight="28" Margin="0,0,4,4"
                                    Command="{Binding DeleteSelectedCommand}"
                                    AutomationProperties.Name="Delete selected hierarchy item" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Up" MinWidth="48" MinHeight="28" Margin="0,0,4,4"
                                    Command="{Binding MoveSelectedUpCommand}"
                                    IsEnabled="{Binding CanMoveSelectedUp}"
                                    AutomationProperties.Name="Move selected item up"
                                    AutomationProperties.HelpText="Keyboard alternative to drag-and-drop reordering."
                                    ToolTip="Move selected item up" />
                            <Button Content="Down" MinWidth="56" MinHeight="28" Margin="0,0,4,4"
                                    Command="{Binding MoveSelectedDownCommand}"
                                    IsEnabled="{Binding CanMoveSelectedDown}"
                                    AutomationProperties.Name="Move selected item down"
                                    AutomationProperties.HelpText="Keyboard alternative to drag-and-drop reordering."
                                    ToolTip="Move selected item down" />
                            <Button Content="Move To…" MinWidth="80" MinHeight="28" Margin="0,0,4,4"
                                    Command="{Binding MoveSelectedToCommand}"
                                    IsEnabled="{Binding CanMoveSelectedTo}"
                                    AutomationProperties.Name="Move selected item to another parent"
                                    AutomationProperties.HelpText="Keyboard alternative to dragging a chapter onto a part or a scene onto a chapter."
                                    ToolTip="Move chapter to part, or scene to chapter" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="8">
                        <TextBlock Text="Compile export file" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ExportFileName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6"
                                 AutomationProperties.Name="Compile export file name" />
                        <Button Content="Compile selected"
                                Padding="10,6"
                                MinHeight="32"
                                Command="{Binding CompileSelectedCommand}"
                                AutomationProperties.Name="Compile selected chapters" />
                    </StackPanel>
                    <TreeView x:Name="HierarchyTree"
                              ItemsSource="{Binding HierarchyRoots}"
                              BorderThickness="0"
                              Background="Transparent"
                              Margin="4,0"
                              AllowDrop="True"
                              PreviewMouseMove="HierarchyTree_OnPreviewMouseMove"
                              PreviewMouseLeftButtonDown="HierarchyTree_OnPreviewMouseLeftButtonDown"
                              DragOver="HierarchyTree_OnDragOver"
                              Drop="HierarchyTree_OnDrop"
                              SelectedItemChanged="HierarchyTree_OnSelectedItemChanged"
                              AutomationProperties.Name="Manuscript hierarchy"
                              AutomationProperties.HelpText="Books, parts, chapters and scenes. Use Up, Down and Move To as keyboard alternatives to drag-and-drop.">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Centre: editor or corkboard -->
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid Visibility="{Binding IsCorkboardMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Save"
                                MinWidth="80"
                                MinHeight="32"
                                Margin="8,0,0,0"
                                Command="{Binding SaveChapterCommand}"
                                AutomationProperties.Name="Save chapter" />
                        <Button DockPanel.Dock="Right"
                                Content="Rename"
                                MinWidth="80"
                                MinHeight="32"
                                Margin="0,0,8,0"
                                Command="{Binding RenameChapterCommand}"
                                AutomationProperties.Name="Rename loaded chapter" />
                        <TextBox Text="{Binding ChapterTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 MinHeight="32"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Chapter title" />
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="B" MinWidth="32" MinHeight="28" Margin="0,0,4,4"
                                Command="{Binding FormatMarkdownCommand}" CommandParameter="{x:Static manuscript:MarkdownFormatKind.Bold}"
                                ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold" />
                        <Button Content="I" MinWidth="32" MinHeight="28" Margin="0,0,4,4"
                                Command="{Binding FormatMarkdownCommand}" CommandParameter="{x:Static manuscript:MarkdownFormatKind.Italic}"
                                ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic" />
                        <Button Content="H1" MinWidth="36" MinHeight="28" Margin="0,0,4,4"
                                Command="{Binding FormatMarkdownCommand}" CommandParameter="{x:Static manuscript:MarkdownFormatKind.Heading1}"
                                ToolTip="Heading 1" AutomationProperties.Name="Heading 1" />
                        <Button Content="H2" MinWidth="36" MinHeight="28" Margin="0,0,4,4"
                                Command="{Binding FormatMarkdownCommand}" CommandParameter="{x:Static manuscript:MarkdownFormatKind.Heading2}"
                                ToolTip="Heading 2" AutomationProperties.Name="Heading 2" />
                        <Button Content="H3" MinWidth="36" MinHeight="28" Margin="0,0,4,4"
                                Command="{Binding FormatMarkdownCommand}" CommandParameter="{x:Static manuscript:MarkdownFormatKind.Heading3}"
                                ToolTip="Heading 3" AutomationProperties.Name="Heading 3" />
                        <Button Content="• List" MinWidth="56" MinHeight="28" Margin="0,0,4,4"
                                Command="{Binding FormatMarkdownCommand}" CommandParameter="{x:Static manuscript:MarkdownFormatKind.BulletList}"
                                ToolTip="Bullet list" AutomationProperties.Name="Bullet list" />
                        <Button Content="1. List" MinWidth="56" MinHeight="28" Margin="0,0,4,4"
                                Command="{Binding FormatMarkdownCommand}" CommandParameter="{x:Static manuscript:MarkdownFormatKind.NumberedList}"
                                ToolTip="Numbered list" AutomationProperties.Name="Numbered list" />
                        <Button Content="Quote" MinWidth="56" MinHeight="28" Margin="0,0,4,4"
                                Command="{Binding FormatMarkdownCommand}" CommandParameter="{x:Static manuscript:MarkdownFormatKind.BlockQuote}"
                                ToolTip="Block quote" AutomationProperties.Name="Block quote" />
                    </WrapPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="*" MinWidth="140" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock DockPanel.Dock="Top" Text="Markdown" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="MarkdownEditor"
                                     Text="{Binding MarkdownText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     IsUndoEnabled="True"
                                     UndoLimit="100"
                                     AutomationProperties.Name="Manuscript markdown editor">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="B" Modifiers="Control"
                                                Command="{Binding FormatMarkdownCommand}"
                                                CommandParameter="{x:Static manuscript:MarkdownFormatKind.Bold}" />
                                    <KeyBinding Key="I" Modifiers="Control"
                                                Command="{Binding FormatMarkdownCommand}"
                                                CommandParameter="{x:Static manuscript:MarkdownFormatKind.Italic}" />
                                    <KeyBinding Key="D1" Modifiers="Control"
                                                Command="{Binding FormatMarkdownCommand}"
                                                CommandParameter="{x:Static manuscript:MarkdownFormatKind.Heading1}" />
                                    <KeyBinding Key="D2" Modifiers="Control"
                                                Command="{Binding FormatMarkdownCommand}"
                                                CommandParameter="{x:Static manuscript:MarkdownFormatKind.Heading2}" />
                                    <KeyBinding Key="D3" Modifiers="Control"
                                                Command="{Binding FormatMarkdownCommand}"
                                                CommandParameter="{x:Static manuscript:MarkdownFormatKind.Heading3}" />
                                    <KeyBinding Key="L" Modifiers="Control"
                                                Command="{Binding FormatMarkdownCommand}"
                                                CommandParameter="{x:Static manuscript:MarkdownFormatKind.BulletList}" />
                                    <KeyBinding Key="Q" Modifiers="Control"
                                                Command="{Binding FormatMarkdownCommand}"
                                                CommandParameter="{x:Static manuscript:MarkdownFormatKind.BlockQuote}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Top" Text="Preview" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                <WebBrowser x:Name="PreviewBrowser" />
                            </Border>
                        </DockPanel>
                    </Grid>

                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Text="{Binding AssociationCountsDisplay}"
                                   TextWrapping="Wrap"
                                   MaxWidth="520"
                                   AutomationProperties.Name="Association word counts" />
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource WarningLiveTextStyle}"
                                   Text="Unsaved changes"
                                   AutomationProperties.Name="Unsaved changes"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SaveStateLiveTextStyle}"
                                   Text="{Binding SaveStateDisplay}"
                                   AutomationProperties.Name="{Binding SaveStateAccessibleName}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource StatusLiveTextStyle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Manuscript status message" />
                    </DockPanel>
                </Grid>

                <ContentControl Visibility="{Binding IsCorkboardMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Content="{Binding Corkboard}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:SceneCorkboardViewModel}">
                            <views:SceneCorkboardView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>

            <!-- Right: scene metadata + outline context -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}"
                    Width="300"
                    Visibility="{Binding IsRightChromeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="Scene drafting" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" Text="Outline" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox DockPanel.Dock="Top"
                              Margin="0,0,0,6"
                              ItemsSource="{Binding SceneOutline}"
                              SelectedItem="{Binding SelectedOutlineItem}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="Scene outline navigator" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Go to prose"
                                MinWidth="90"
                                MinHeight="28"
                                Margin="0,0,6,0"
                                Command="{Binding NavigateToSelectedSceneProseCommand}"
                                AutomationProperties.Name="Navigate to selected scene prose" />
                        <Button Content="Associate selection"
                                MinWidth="120"
                                MinHeight="28"
                                Command="{Binding AssociateSelectedSceneWithSelectionCommand}"
                                ToolTip="Wrap the current editor selection with scene markers (explicit; never auto-inferred)."
                                AutomationProperties.Name="Associate selection with selected scene" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom"
                            Content="Open in Story Data"
                            Margin="0,8,0,0"
                            MinHeight="32"
                            Command="{Binding OpenContextInStoryDataCommand}"
                            AutomationProperties.Name="Open selected scene in Story Data" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" MaxHeight="110">
                        <TextBlock DockPanel.Dock="Top" Text="Bracket notes" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding BracketNotes}"
                                 SelectedItem="{Binding SelectedBracketNote}"
                                 DisplayMemberPath="Display"
                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                 AutomationProperties.Name="Bracket notes in chapter"
                                 AutomationProperties.HelpText="Select a note to move the caret to that [CHECK], [FIX], or [REWRITE]." />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding ContextTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ContextSummary}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.85" />
                            <StackPanel DataContext="{Binding SceneDraftEditor}"
                                        Visibility="{Binding DataContext.HasSceneDraftEditor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Scene metadata" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Status" />
                                <ComboBox Margin="0,0,0,6"
                                          ItemsSource="{Binding DataContext.SceneStatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Status}"
                                          AutomationProperties.Name="Scene draft status" />
                                <TextBlock Text="Viewpoint" />
                                <ComboBox Margin="0,0,0,6"
                                          ItemsSource="{Binding DataContext.ViewpointOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding ViewpointCharacterId}"
                                          SelectedValuePath="CharacterId"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.Name="Scene viewpoint character" />
                                <TextBlock Text="Location" />
                                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                <TextBlock Text="Time" />
                                <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                <TextBlock Text="Goal" />
                                <TextBox Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="Opposition" />
                                <TextBox Text="{Binding Opposition, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="Stakes" />
                                <TextBox Text="{Binding Stakes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="Outcome" />
                                <TextBox Text="{Binding Outcome, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="Consequence" />
                                <TextBox Text="{Binding Consequence, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="Setup notes" />
                                <TextBox Text="{Binding SetupObligations, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="Payoff notes" />
                                <TextBox Text="{Binding PayoffObligations, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <Button Content="Save scene metadata"
                                        MinHeight="32"
                                        Command="{Binding DataContext.SaveSceneMetadataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        AutomationProperties.Name="Save scene metadata" />
                            </StackPanel>
                            <TextBlock Text="Select a linked scene to edit metadata beside its prose."
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasSceneDraftEditor, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

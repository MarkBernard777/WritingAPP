<UserControl x:Class="MasterBookWritingSystem.App.Views.ManuscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Undo"
                        Width="70"
                        Margin="0,0,6,0"
                        Command="ApplicationCommands.Undo"
                        CommandTarget="{Binding ElementName=MarkdownEditor}"
                        ToolTip="Undo manuscript text (Ctrl+Z)"
                        AutomationProperties.Name="Undo manuscript text" />
                <Button Content="Redo"
                        Width="70"
                        Margin="0,0,6,0"
                        Command="ApplicationCommands.Redo"
                        CommandTarget="{Binding ElementName=MarkdownEditor}"
                        ToolTip="Redo manuscript text (Ctrl+Y)"
                        AutomationProperties.Name="Redo manuscript text" />
                <Button Content="Refresh"
                        Width="90"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
            <TextBlock Text="Manuscript"
                       FontSize="26"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button Content="Add" Width="64" Margin="0,0,6,6" Command="{Binding AddChapterCommand}" />
                        <Button Content="Delete" Width="64" Margin="0,0,6,6" Command="{Binding DeleteChapterCommand}" />
                        <Button Content="Up" Width="48" Margin="0,0,6,6" Command="{Binding MoveChapterUpCommand}" />
                        <Button Content="Down" Width="56" Margin="0,0,6,6" Command="{Binding MoveChapterDownCommand}" />
                    </WrapPanel>
                    <TextBlock Text="Compile export file" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBox Text="{Binding ExportFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    <Button Content="Compile selected"
                            Padding="10,6"
                            Command="{Binding CompileSelectedCommand}" />
                </StackPanel>
                <Border Background="#F7FAFC" Padding="8" CornerRadius="6">
                    <ListBox ItemsSource="{Binding Chapters}"
                             SelectedItem="{Binding SelectedChapter}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <CheckBox DockPanel.Dock="Left"
                                              IsChecked="{Binding IsSelectedForCompile}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                        <TextBlock Opacity="0.7" FontSize="11">
                                            <Run Text="{Binding WordCount, Mode=OneWay}" />
                                            <Run Text=" words" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Content="Save"
                            Width="80"
                            Margin="8,0,0,0"
                            Command="{Binding SaveChapterCommand}" />
                    <Button DockPanel.Dock="Right"
                            Content="Rename"
                            Width="80"
                            Command="{Binding RenameChapterCommand}" />
                    <TextBox Text="{Binding ChapterTitle, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock DockPanel.Dock="Top" Text="Markdown" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="MarkdownEditor"
                                 Text="{Binding MarkdownText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 IsUndoEnabled="True"
                                 UndoLimit="100"
                                 AutomationProperties.Name="Manuscript markdown editor" />
                    </DockPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Preview" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Border BorderBrush="#E2E8F0" BorderThickness="1">
                            <WebBrowser x:Name="PreviewBrowser" />
                        </Border>
                    </DockPanel>
                </Grid>

                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Content="Open in Story Data"
                                Padding="10,4"
                                Command="{Binding OpenLinkedSceneInStoryDataCommand}" />
                        <TextBlock Text="Linked scenes (read-only)"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding LinkedScenes}"
                             SelectedItem="{Binding SelectedLinkedScene}"
                             DisplayMemberPath="DisplayName"
                             BorderBrush="#E2E8F0" />
                </DockPanel>

                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Bracket notes" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding BracketNotes}"
                             DisplayMemberPath="Display"
                             BorderBrush="#E2E8F0" />
                </DockPanel>

                <DockPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Run Text="{Binding WordCount, Mode=OneWay}" />
                        <Run Text=" words" />
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Left"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#C05621"
                               Text="Unsaved changes"
                               Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock DockPanel.Dock="Left"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding SaveStateDisplay}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#276749"
                               TextWrapping="Wrap"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

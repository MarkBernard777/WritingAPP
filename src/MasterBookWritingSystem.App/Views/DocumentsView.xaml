<UserControl x:Class="MasterBookWritingSystem.App.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Undo"
                        Width="70"
                        Margin="0,0,6,0"
                        Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoTooltip}"
                        AutomationProperties.Name="{Binding UndoTooltip}" />
                <Button Content="Redo"
                        Width="70"
                        Margin="0,0,6,0"
                        Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoTooltip}"
                        AutomationProperties.Name="{Binding RedoTooltip}" />
                <Button Content="Refresh"
                        Width="90"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh working documents" />
            </StackPanel>
            <TextBlock Text="Working Documents"
                       FontSize="26"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    Padding="8"
                    Margin="0,0,12,0"
                    CornerRadius="6">
                <ListBox ItemsSource="{Binding Documents}"
                         SelectedItem="{Binding SelectedDocument}"
                         BorderThickness="0"
                         Background="Transparent"
                         AutomationProperties.Name="Working document list">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.7" FontSize="11">
                                    <Run Text="{Binding CompletionPercentage, Mode=OneWay}" />
                                    <Run Text="% complete" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedDocument.Title}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ValidationMessage}"
                               Margin="0,0,0,12"
                               Opacity="0.8"
                               TextWrapping="Wrap" />

                    <StackPanel Visibility="{Binding IsSceneListDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding SceneInventoryExplanation}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="Scene inventory" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding SceneInventory}"
                                  SelectedItem="{Binding SelectedInventoryScene}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  MinHeight="180"
                                  MaxHeight="360"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="40" />
                                <DataGridTextColumn Header="Chapter" Binding="{Binding ChapterDisplayName}" Width="*" />
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="POV" Binding="{Binding ViewpointDisplayName}" Width="100" />
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="100" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Open / Edit in Story Data"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                Margin="0,0,0,16"
                                Command="{Binding OpenSelectedSceneInStoryDataCommand}" />
                        <TextBlock Text="Optional document notes (not the scene inventory)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSceneListDocument, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock Text="Structured fields" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,6,0,0"
                                                         MinHeight="40"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         IsUndoEnabled="True"
                                                         UndoLimit="100"
                                                         AutomationProperties.Name="{Binding Label}"
                                                         GotFocus="FieldEditor_GotFocus"
                                                         LostFocus="FieldEditor_LostFocus" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Save"
                                                    VerticalAlignment="Center"
                                                    Padding="10,4"
                                                    Command="{Binding DataContext.SaveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Markdown notes" FontWeight="SemiBold" Margin="0,20,0,8" />
                    </StackPanel>

                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="100"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             IsUndoEnabled="True"
                             UndoLimit="100"
                             AutomationProperties.Name="Document notes"
                             GotFocus="NotesEditor_GotFocus"
                             LostFocus="NotesEditor_LostFocus" />
                    <Button Content="Save notes"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Padding="12,6"
                            Command="{Binding SaveNotesCommand}" />

                    <TextBlock Text="{Binding SaveStateDisplay}"
                               Style="{StaticResource SaveStateLiveTextStyle}"
                               AutomationProperties.Name="{Binding SaveStateAccessibleName}"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource StatusLiveTextStyle}"
                               Margin="0,4,0,0"
                               AutomationProperties.Name="Documents status message" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

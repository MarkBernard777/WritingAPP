<UserControl x:Class="MasterBookWritingSystem.App.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Width="90"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh drafting progress" />
                <TextBlock Text="Drafting progress"
                           FontSize="26"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource StatusLiveTextStyle}"
                       Margin="0,0,0,12"
                       AutomationProperties.Name="Progress status message" />

            <Border Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    Padding="20"
                    CornerRadius="8">
                <TextBlock Text="No project is open. Open a project to use drafting targets and sessions."
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource AppPanelBackgroundBrush}" Padding="16" CornerRadius="8" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Session timer" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Margin="0,0,0,8">
                            <Run Text="State: " />
                            <Run Text="{Binding TimerStateLabel, Mode=OneWay}" />
                            <Run Text="  ·  Active " />
                            <Run Text="{Binding TimerElapsedDisplay, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding IdleThresholdHelp}" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start" MinWidth="72" Margin="0,0,8,0" Command="{Binding StartTimerCommand}"
                                    AutomationProperties.Name="Start drafting timer" />
                            <Button Content="Pause" MinWidth="72" Margin="0,0,8,0" Command="{Binding PauseTimerCommand}"
                                    IsEnabled="{Binding CanPause}"
                                    AutomationProperties.Name="Pause drafting timer" />
                            <Button Content="Resume" MinWidth="72" Margin="0,0,8,0" Command="{Binding ResumeTimerCommand}"
                                    IsEnabled="{Binding CanResume}"
                                    AutomationProperties.Name="Resume drafting timer" />
                            <Button Content="Stop" MinWidth="72" Command="{Binding StopTimerCommand}"
                                    IsEnabled="{Binding CanStop}"
                                    AutomationProperties.Name="Stop drafting timer" />
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding HasInterruptedSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Interrupted session" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding InterruptedSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Resume interrupted" MinWidth="140" Margin="0,0,8,0"
                                        Command="{Binding ResumeInterruptedCommand}"
                                        AutomationProperties.Name="Resume interrupted drafting session" />
                                <Button Content="Close interrupted" MinWidth="140"
                                        Command="{Binding CloseInterruptedCommand}"
                                        AutomationProperties.Name="Close interrupted drafting session" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppPanelBackgroundBrush}" Padding="16" CornerRadius="8" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Drafting targets" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Width="120" VerticalAlignment="Center" Text="Daily words" />
                            <TextBox Text="{Binding DailyWordGoal, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Daily word goal" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Width="120" VerticalAlignment="Center" Text="Weekly words" />
                            <TextBox Text="{Binding WeeklyWordGoal, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Weekly word goal" />
                        </DockPanel>
                        <CheckBox Content="Targets enabled" IsChecked="{Binding TargetsEnabled}" Margin="0,0,0,8"
                                  AutomationProperties.Name="Enable drafting targets" />
                        <Button Content="Save targets" Width="120" HorizontalAlignment="Left"
                                Command="{Binding SaveTargetsCommand}"
                                AutomationProperties.Name="Save drafting targets" />
                        <TextBlock Text="{Binding TodaySummary}" Margin="0,12,0,4" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WeekSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppPanelBackgroundBrush}" Padding="16" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Progress (recalculated from sessions)" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Today" MinWidth="72" Margin="0,0,8,0" Command="{Binding ShowTodayCommand}" />
                            <Button Content="This week" MinWidth="90" Margin="0,0,8,0" Command="{Binding ShowThisWeekCommand}" />
                            <DatePicker SelectedDate="{Binding RangeFrom}" Width="140" Margin="0,0,8,0"
                                        AutomationProperties.Name="Progress range from date" />
                            <DatePicker SelectedDate="{Binding RangeTo}" Width="140" Margin="0,0,8,0"
                                        AutomationProperties.Name="Progress range to date" />
                            <Button Content="Apply range" MinWidth="100" Command="{Binding LoadRangeCommand}"
                                    AutomationProperties.Name="Apply progress date range" />
                        </StackPanel>
                        <TextBlock Text="{Binding ProgressSummary}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   AutomationProperties.Name="Progress summary" />

                        <TextBlock Text="By date" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding ByDate}" AutoGenerateColumns="False" IsReadOnly="True"
                                  MaxHeight="160" Margin="0,0,0,12"
                                  AutomationProperties.Name="Progress by date">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Words" Binding="{Binding NetWords}" Width="80" />
                                <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="By chapter" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding ByChapter}" AutoGenerateColumns="False" IsReadOnly="True"
                                  MaxHeight="140" Margin="0,0,0,12"
                                  AutomationProperties.Name="Progress by chapter">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chapter" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Words" Binding="{Binding NetWords}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="By scene" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding ByScene}" AutoGenerateColumns="False" IsReadOnly="True"
                                  MaxHeight="140" Margin="0,0,0,12"
                                  AutomationProperties.Name="Progress by scene">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Scene" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Words" Binding="{Binding NetWords}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="By viewpoint" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding ByViewpoint}" AutoGenerateColumns="False" IsReadOnly="True"
                                  MaxHeight="140"
                                  AutomationProperties.Name="Progress by viewpoint">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Viewpoint" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Words" Binding="{Binding NetWords}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

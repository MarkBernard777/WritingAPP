<UserControl x:Class="MasterBookWritingSystem.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Refresh" Width="90" Command="{Binding RefreshCommand}" />
            <TextBlock Text="Backup &amp; Export" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Snapshot retention (application setting)" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding SnapshotRetentionExplanation}"
                           TextWrapping="Wrap"
                           Opacity="0.9"
                           Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Active limit" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="80"
                             Text="{Binding SnapshotRetentionLimitText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" />
                    <Button Content="Save retention"
                            Padding="12,6"
                            Command="{Binding SaveSnapshotRetentionCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Exports (Exports/ · never overwrite)" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="Export DOCX" Margin="0,0,8,8" Padding="12,6" Command="{Binding ExportDocxCommand}" />
                        <Button Content="Export JSON" Margin="0,0,8,8" Padding="12,6" Command="{Binding ExportJsonCommand}" />
                        <Button Content="Export CSV" Margin="0,0,8,8" Padding="12,6" Command="{Binding ExportCsvCommand}" />
                        <Button Content="Export portable ZIP" Margin="0,0,8,8" Padding="12,6" Command="{Binding ExportPortableZipCommand}" />
                    </WrapPanel>

                    <TextBlock Text="Manual snapshots (13 Archive/Snapshots)" FontWeight="SemiBold" Margin="0,16,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Create snapshot" Margin="0,0,8,0" Padding="12,6" Command="{Binding CreateSnapshotCommand}" />
                        <Button Content="Inspect" Margin="0,0,8,0" Padding="12,6" Command="{Binding InspectSnapshotCommand}" />
                        <Button Content="Restore…" Padding="12,6" Command="{Binding RestoreSnapshotCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Snapshots}"
                             SelectedItem="{Binding SelectedSnapshot}"
                             DisplayMemberPath="DisplayWithKind"
                             Height="140"
                             Margin="0,0,0,8" />
                    <TextBlock Text="{Binding RestorePreview}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />

                    <TextBlock Text="Portable import" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <Button Content="Import ZIP into new folder…" HorizontalAlignment="Left" Padding="12,6"
                            Command="{Binding ImportPortableZipCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding ProgressMessage}" Opacity="0.7" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#276749" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>

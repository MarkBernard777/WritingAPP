<UserControl x:Class="MasterBookWritingSystem.App.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ComboBox Width="160"
                          ItemsSource="{Binding PublishingRoutes}"
                          SelectedItem="{Binding SelectedRoute}"
                          VerticalAlignment="Center" />
                <Button Content="Apply Route"
                        Margin="8,0,8,0"
                        Padding="10,4"
                        Command="{Binding ChangeRouteCommand}" />
                <Button Content="Refresh"
                        Padding="10,4"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
            <TextBlock Text="Guided Workflow"
                       FontSize="26"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F7FAFC"
                    Padding="8"
                    Margin="0,0,12,0"
                    CornerRadius="6">
                <ListBox ItemsSource="{Binding Phases}"
                         SelectedItem="{Binding SelectedPhase}"
                         BorderThickness="0"
                         Background="Transparent"
                         DisplayMemberPath="Title" />
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedPhase.Title}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Deliverable}"
                               Opacity="0.8"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding TemplatePath}"
                               Opacity="0.6"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Steps" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,6,0,0"
                                                     AcceptsReturn="True"
                                                     Height="48"
                                                     TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Done"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Foreground="#276749"
                                                       FontWeight="SemiBold" />
                                            <Button Content="Complete"
                                                    Padding="10,4"
                                                    Command="{Binding DataContext.CompleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#EDF2F7" Padding="16" Margin="0,20,0,0" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Phase gate" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding GateStatement}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,12" />
                            <TextBlock Text="Evidence" FontWeight="SemiBold" />
                            <TextBox Text="{Binding GateEvidence, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,8"
                                     Height="56"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True" />
                            <TextBlock Text="Notes" FontWeight="SemiBold" />
                            <TextBox Text="{Binding GateNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,12"
                                     Height="48"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True" />
                            <TextBlock Text="Gate passed"
                                       Foreground="#276749"
                                       FontWeight="SemiBold"
                                       Visibility="{Binding IsGatePassed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Confirm and pass gate"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Command="{Binding PassGateCommand}"
                                    IsEnabled="{Binding CanPassGate}"
                                    Visibility="{Binding IsGatePassed, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                            <TextBlock Text="Complete every required step before the gate can be passed."
                                       Opacity="0.7"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding CanPassGate, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#9B2C2C"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

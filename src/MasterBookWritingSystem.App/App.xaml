<Application x:Class="MasterBookWritingSystem.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MasterBookWritingSystem.App.Converters"
             xmlns:views="clr-namespace:MasterBookWritingSystem.App.Views"
             xmlns:vm="clr-namespace:MasterBookWritingSystem.App.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <converters:AppSectionToBooleanConverter x:Key="AppSectionToBooleanConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

            <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#CDD5DE" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#FFFFFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WorkflowViewModel}">
                <views:WorkflowView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
                <views:DocumentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManuscriptViewModel}">
                <views:ManuscriptView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StoryDataViewModel}">
                <views:StoryDataView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
                <views:ToolsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PublishingViewModel}">
                <views:PublishingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecoveryViewModel}">
                <views:RecoveryView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
